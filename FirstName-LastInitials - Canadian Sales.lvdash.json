{
  "datasets": [
    {
      "name": "925ea7c8",
      "displayName": "Opportunities",
      "queryLines": [
        "\n",
        "SELECT *\n",
        "FROM ca_opportunities;"
      ],
      "columns": [
        {
          "displayName": "deal_size",
          "description": "Buckets the deal opportunity into Small, Medium, and Large",
          "expression": "CASE\n  WHEN amount < 500  THEN 'Small'\n  WHEN amount < 5000 THEN 'Medium'\n  ELSE 'Large'\nEND"
        }
      ],
      "catalog": "learn_ai_bi_analysts_sujatasahu8",
      "schema": "aibi_dashboards"
    },
    {
      "name": "ff7b6ba7",
      "displayName": "FullOrdersData",
      "queryLines": [
        "SELECT\n",
        "  c.customername,\n",
        "  c.province,\n",
        "  o.orderdate,\n",
        "  YEAR(o.orderdate) AS year,\n",
        "  p.productname,\n",
        "  o.orderamt,\n",
        "  o.quantity,\n",
        "  o.salesrep\n",
        "FROM ca_orders AS o\n",
        "  INNER JOIN ca_customers AS c\n",
        "  ON o.customerid = c.customerid\n",
        "  INNER JOIN ca_products AS p\n",
        "  ON o.productid = p.productid;"
      ],
      "catalog": "learn_ai_bi_analysts_sujatasahu8",
      "schema": "aibi_dashboards"
    },
    {
      "name": "b5cd2c4e",
      "displayName": "SalesTargets",
      "queryLines": [
        "SELECT\n",
        "  t.target_set_date,\n",
        "  t.target_year,\n",
        "  t.sales_target,\n",
        "  ROUND(SUM(o.orderamt), 2)                                       AS actual_sales,\n",
        "  ROUND(SUM(o.orderamt) - t.sales_target, 2)                      AS variance,\n",
        "  ROUND((SUM(o.orderamt) - t.sales_target) / t.sales_target * 100, 2) AS variance_pct,\n",
        "  CASE\n",
        " WHEN SUM(o.orderamt) >= t.sales_target THEN 'HIT'\n",
        " ELSE 'MISS'\n",
        "  END                                                             AS status,\n",
        "  t.notes\n",
        "FROM ca_sales_targets AS t\n",
        "  INNER JOIN ca_orders AS o\n",
        "  ON YEAR(o.orderdate) = t.target_year\n",
        "GROUP BY t.target_set_date, t.target_year, t.sales_target, t.notes\n",
        "ORDER BY t.target_year DESC;"
      ],
      "catalog": "learn_ai_bi_analysts_sujatasahu8",
      "schema": "aibi_dashboards"
    },
    {
      "name": "44399360",
      "displayName": "Untitled dataset",
